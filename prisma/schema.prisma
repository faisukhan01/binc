generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admission {
  id            String        @id @default(cuid())
  trackingCode  String        @unique
  fullName      String
  fatherName    String
  email         String?
  phone         String
  program       String
  qualification String
  lastMarks     String?
  city          String
  isWelfare     Boolean       @default(false)
  message       String?
  status        String        @default("PENDING") // PENDING | CONTACTED | APPROVED | REJECTED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  events        StatusEvent[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("Notice") // Notice | Event | Deadline | Result
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  program   String
  quote     String
  rating    Int      @default(5) // 1..5
  photoUrl  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StatusEvent {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  status      String
  createdAt   DateTime  @default(now())

  @@index([admissionId])
}
